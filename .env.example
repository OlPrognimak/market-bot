# Market Bot environment template
# Copy to .env and adjust local values. Do not commit .env.

# ---------------------------------------------------------------------------
# Compose / runtime
# ---------------------------------------------------------------------------
MARKET_BOT_IMAGE_TAG=0.0.1-SNAPSHOT
MARKET_BOT_PORT=8080
MARKET_BOT_WATCHLIST_HOST_FILE=./config/watchlist.yaml
MARKET_BOT_LOG_DIR=./logs
SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_APPLICATION_NAME=market-bot
SPRING_MAIN_WEB_APPLICATION_TYPE=servlet
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=marketbot
SPRING_JPA_PROPERTIES_HIBERNATE_HBM2DDL_CREATE_NAMESPACES=true
SPRING_JPA_PROPERTIES_HIBERNATE_CONNECTION_POOL_SIZE=30

# Frontend dev server
NEXT_PUBLIC_MARKET_BOT_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
APP_DATASOURCE_URL=jdbc:postgresql://localhost:5455/test_db
APP_DATASOURCE_USERNAME=test
APP_DATASOURCE_PASSWORD=test

# For Docker on macOS, use the host PostgreSQL address:
# APP_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5455/test_db

# ---------------------------------------------------------------------------
# Security / bootstrap admin
# ---------------------------------------------------------------------------
APP_SECURITY_JWT_SECRET=change-this-secret-before-production
APP_SECURITY_JWT_EXPIRATION_MINUTES=480
APP_SECURITY_ADMIN_USERNAME=admin
APP_SECURITY_ADMIN_PASSWORD=admin123
APP_SECURITY_ADMIN_EMAIL=admin@market-bot.local
APP_SECURITY_ADMIN_DISPLAY_NAME=Administrator

# ---------------------------------------------------------------------------
# AI / provider credentials
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_NEWS_MODEL=gpt-5-mini
OPENAI_WEB_RESEARCH_MODEL=gpt-5-mini
FINNHUB_API_KEY=
TWELVE_API_KEY=

# Telegram can be empty when credentials are stored in the database.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MARKET_BOT_NOTIFICATION_MAX_CONCURRENT_SENDS=20

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
MARKET_BOT_LOG_LEVEL=INFO
MARKET_BOT_LOG_FILE=/app/logs/market-bot.log
MARKET_BOT_LOG_MAX_FILE_SIZE=10MB
MARKET_BOT_LOG_MAX_HISTORY=14
MARKET_BOT_LOG_TOTAL_SIZE_CAP=200MB
MARKET_BOT_LOG_CLEAN_HISTORY_ON_START=false

# ---------------------------------------------------------------------------
# Share scanner
# ---------------------------------------------------------------------------
MARKET_BOT_WATCHLIST_FILE=classpath:/watchlist.yaml
MARKET_BOT_SCANNER_POLL_INTERVAL_MS=30000
MARKET_BOT_QUOTE_CHANGE_EPSILON=0.01
MARKET_BOT_MAX_CHANGES_FOR_PERSIST=0.1
MARKET_BOT_MAX_QUOTE_FETCH_ATTEMPTS=3
MARKET_BOT_QUOTE_FETCH_RETRY_DELAY_MS=1000

MARKET_BOT_ALERT_DROP_ALERT_PERCENT=-0.2
MARKET_BOT_ALERT_RISE_ALERT_PERCENT=0.2
MARKET_BOT_ALERT_MAXIMAL_ROLLING_PRICE=0.5
MARKET_BOT_ALERT_MAXIMAL_ROLLING_SIZE=15

# ---------------------------------------------------------------------------
# Adaptive trend calibration
# ---------------------------------------------------------------------------
MARKET_BOT_TREND_ADAPTIVE_ENABLED=true
MARKET_BOT_TREND_RECALIBRATE_ON_STARTUP=true
MARKET_BOT_TREND_RECALIBRATION_CRON="0 15 2 * * *"
MARKET_BOT_TREND_RECALIBRATION_ZONE=Europe/Berlin
MARKET_BOT_TREND_OBSERVATION_WINDOW=15
MARKET_BOT_TREND_SHORT_WINDOW=5
MARKET_BOT_TREND_EVALUATION_HORIZON=5
MARKET_BOT_TREND_LOOKBACK_DAYS=30
MARKET_BOT_TREND_MINIMUM_TRADING_DAYS=10
MARKET_BOT_TREND_MINIMUM_WINDOWS=100
MARKET_BOT_TREND_DEFAULT_LONG_WEIGHT=0.35
MARKET_BOT_TREND_DEFAULT_SHORT_WEIGHT=0.65
MARKET_BOT_TREND_DEFAULT_MINIMUM_SCORE_PERCENT=0.15
MARKET_BOT_TREND_MINIMUM_SHORT_WEIGHT=0.25
MARKET_BOT_TREND_MAXIMUM_SHORT_WEIGHT=0.80
MARKET_BOT_TREND_MINIMUM_CONFIDENCE=0.55
MARKET_BOT_TREND_THRESHOLD_MULTIPLIER=2.0
MARKET_BOT_TREND_MINIMUM_ADAPTIVE_SCORE_PERCENT=0.05
MARKET_BOT_TREND_MAXIMUM_ADAPTIVE_SCORE_PERCENT=1.0
MARKET_BOT_TREND_MAXIMUM_PROFILE_AGE_DAYS=7
MARKET_BOT_TREND_LOWER_RANGE_POSITION=0.40
MARKET_BOT_TREND_UPPER_RANGE_POSITION=0.60
MARKET_BOT_TREND_PREVIOUS_CLOSE_TOLERANCE=0.01
MARKET_BOT_TREND_PROFILE_QUALITY_IMPROVEMENT=0.02
MARKET_BOT_TREND_MAXIMUM_WEIGHT_CHANGE=0.10

# ---------------------------------------------------------------------------
# Crypto scanner
# ---------------------------------------------------------------------------
MARKET_BOT_CRYPTO_SCANNER_ENABLED=true
MARKET_BOT_CRYPTO_POLL_INTERVAL_MS=60000
MARKET_BOT_CRYPTO_WATCHLIST_FILE=classpath:/crypto-watchlist.yaml
MARKET_BOT_CRYPTO_MIN_QUOTE_VOLUME=300000
MARKET_BOT_CRYPTO_PRICE_CHANGE_PERCENT=3
MARKET_BOT_CRYPTO_SCAN_WINDOW=5m
MARKET_BOT_CRYPTO_MAX_QUOTE_FETCH_ATTEMPTS=3
MARKET_BOT_CRYPTO_QUOTE_FETCH_RETRY_DELAY_MS=1000

# ---------------------------------------------------------------------------
# Extended-hours and futures scanners
# ---------------------------------------------------------------------------
MARKET_BOT_EXTENDED_HOURS_ENABLED=true
MARKET_BOT_EXTENDED_HOURS_POLL_INTERVAL_MS=60000
MARKET_BOT_EXTENDED_HOURS_STALE_AFTER_SECONDS=180
MARKET_BOT_EXTENDED_HOURS_ROLLING_SIZE=15

MARKET_BOT_FUTURES_ENABLED=true
MARKET_BOT_FUTURES_POLL_INTERVAL_MS=60000
MARKET_BOT_FUTURES_STALE_AFTER_SECONDS=180
MARKET_BOT_FUTURES_ROLLING_SIZE=15

# ---------------------------------------------------------------------------
# News monitoring
# ---------------------------------------------------------------------------
MARKET_BOT_NEWS_MONITORING_ENABLED=true
MARKET_BOT_NEWS_LOOKBACK_HOURS=168
MARKET_BOT_NEWS_MAX_ARTICLES_PER_INSTRUMENT=10
MARKET_BOT_NEWS_MINIMUM_CONFIDENCE=65
MARKET_BOT_NEWS_MINIMUM_IMPACT_SCORE=70
MARKET_BOT_NEWS_MAXIMUM_ANALYSIS_AGE_HOURS=72
MARKET_BOT_NEWS_SEND_ALERTS=false
MARKET_BOT_NEWS_BACKGROUND_MONITORING_ENABLED=false
MARKET_BOT_NEWS_BACKGROUND_POLL_INTERVAL_MS=900000
MARKET_BOT_NEWS_YAHOO_ENABLED=true
MARKET_BOT_NEWS_FINNHUB_ENABLED=true

# ---------------------------------------------------------------------------
# Dashboard
# scan trigger modes: BACKEND_SCHEDULED, FRONTEND_TRIGGERED, BOTH
# ---------------------------------------------------------------------------
MARKET_BOT_DASHBOARD_ENABLED=true
MARKET_BOT_DASHBOARD_WEBSOCKET_ENABLED=true
MARKET_BOT_DASHBOARD_SCAN_TRIGGER_MODE=BOTH
MARKET_BOT_DASHBOARD_MAX_RESULTS=100

# ---------------------------------------------------------------------------
# Optional history backfill profile
# ---------------------------------------------------------------------------
# MARKET_BOT_HISTORY_FROM=2026-01-01
# MARKET_BOT_HISTORY_TO=2026-07-02
# MARKET_BOT_HISTORY_SYMBOLS=AAPL,NVDA
# MARKET_BOT_HISTORY_SOURCE=YAHOO
# MARKET_BOT_HISTORY_INTERVAL_TYPE=DAILY
# MARKET_BOT_HISTORY_REQUEST_DELAY_MS=0

# ---------------------------------------------------------------------------
# Trading / IBKR
# ---------------------------------------------------------------------------
MARKET_BOT_TRADING_ENABLED=true
MARKET_BOT_TRADING_MODE=PAPER
MARKET_BOT_TRADING_LIVE_ENABLED=false
MARKET_BOT_TRADING_REQUIRE_MANUAL_CONFIRMATION=true
MARKET_BOT_TRADING_MAX_ORDER_VALUE_EUR=500
MARKET_BOT_TRADING_MAX_DAILY_LOSS_EUR=100
MARKET_BOT_TRADING_MAX_OPEN_ORDERS_PER_SYMBOL=1
MARKET_BOT_TRADING_MAX_SPREAD_PERCENT=1.0
MARKET_BOT_TRADING_PREVIEW_TTL_SECONDS=60
MARKET_BOT_TRADING_ALLOW_SHORT_SELLING=false
TRADING_ALLOWED_ORDER_TYPES=MARKET,LIMIT

MARKET_BOT_TRADING_IBKR_ENABLED=true
MARKET_BOT_TRADING_IBKR_HOST=127.0.0.1
MARKET_BOT_TRADING_IBKR_PORT=7497
MARKET_BOT_TRADING_IBKR_CLIENT_ID=1
MARKET_BOT_TRADING_IBKR_ACCOUNT_ID=
MARKET_BOT_TRADING_IBKR_PAPER_ACCOUNT_ONLY=true
MARKET_BOT_TRADING_IBKR_CONNECT_ON_STARTUP=false

# For IB Gateway paper on local macOS:
# MARKET_BOT_TRADING_IBKR_PORT=4002
#
# For Docker connecting to IB Gateway/TWS on the Mac host:
# MARKET_BOT_TRADING_IBKR_HOST=host.docker.internal
